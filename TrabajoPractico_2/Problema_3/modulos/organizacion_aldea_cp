from modulos.cola_prioridad import ColaDePrioridad

def leer_aldeas(archivo):
    grafo = {}
    with open(archivo, "r", encoding="utf-8") as f:
        for linea in f:
            linea = linea.strip()
            if not linea or linea.count(",") < 2:
                continue
            origen, destino, dist = [x.strip() for x in linea.split(",")]
            dist = int(dist)
            grafo.setdefault(origen, []).append((destino, dist))
            grafo.setdefault(destino, []).append((origen, dist))
    return grafo


def prim(grafo, inicio):
    visitados = set([inicio])
    pq = ColaDePrioridad()  # usamos tu clase personalizada
    resultado = []
    total = 0

    # Insertar las aristas iniciales desde la aldea de inicio
    for destino, dist in grafo[inicio]:
        pq.insertar(dist, (inicio, destino))

    # Mientras haya aristas disponibles
    while not pq.esta_vacia():
        dist, _, (origen, destino) = pq.eliminar()
        if destino not in visitados:
            visitados.add(destino)
            resultado.append((origen, destino, dist))
            total += dist
            for vecino, d in grafo[destino]:
                if vecino not in visitados:
                    pq.insertar(d, (destino, vecino))

    return resultado, total


def construir_red(resultado):
    recibir = {}
    enviar = {}

    for origen, destino, _ in resultado:
        recibir[destino] = origen
        enviar.setdefault(origen, []).append(destino)
        enviar.setdefault(destino, [])
    return recibir, enviar


